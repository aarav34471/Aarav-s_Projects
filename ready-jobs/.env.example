# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# PostgreSQL / Django database connection
DATABASE=postgres
SQL_ENGINE=django.db.backends.postgresql_psycopg2
SQL_DATABASE=ready_jobs
SQL_USER=ready_jobs
SQL_PASSWORD=replace-with-a-local-password
SQL_HOST=db
SQL_PORT=5432
POSTGRES_DB=ready_jobs
POSTGRES_USER=ready_jobs
POSTGRES_PASSWORD=replace-with-a-local-password

# Optional development data
SEED_DATABASE=0

# React
REACT_APP_API_URL=http://127.0.0.1:8000/api/
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional EmailJS notifications. React variables are exposed to the browser;
# restrict Google Maps and EmailJS origins and usage in their provider dashboards.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_WELCOME_TEMPLATE_ID=
REACT_APP_EMAILJS_STATUS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
